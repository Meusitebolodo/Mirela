body {
    font-family: 'Arial', sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    background-color: #f0f8ff;
    margin: 0;
}

.container {
    text-align: center;
    padding: 20px;
    border-radius: 10px;
    background-color: #fff;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

h1 {
    color: #ff6347;
}

p {
    font-size: 20px;
    font-weight: bold;
    color: #333;
}

#count {
    color: #ff6347;
    font-size: 30px;
    font-weight: bold;
}
